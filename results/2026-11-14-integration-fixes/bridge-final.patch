diff --git a/src/worker-skill-loading.mjs b/src/worker-skill-loading.mjs
new file mode 100644
index 0000000..a6c944f
--- /dev/null
+++ b/src/worker-skill-loading.mjs
@@ -0,0 +1,38 @@
+import { normalize } from 'node:path';
+
+const hint = "Use the read tool to load a skill's file when the task matches its description.";
+const key = value => { const normalized = normalize(value); return process.platform === 'win32' ? normalized.toLowerCase() : normalized; };
+const text = content => typeof content === 'string' ? content : (content ?? []).filter(part => part.type === 'text').map(part => part.text).join('\n');
+
+// Only complete native leading blocks matching this invocation's inventory count.
+// No filesystem reads or persistent loaded flags. Compaction can remove evidence.
+export function loadedNativeSkills(messages, inventory) {
+  const loaded = new Set();
+  for (const message of messages) {
+    if (message.role !== 'user') continue;
+    const match = text(message.content).match(/^<skill name="([^"]+)" location="([^"]+)">\r?\n([\s\S]*?)\r?\n<\/skill>(?:\r?\n\r?\n[\s\S]*)?$/);
+    if (!match || !match[3].replace(/^References are relative to [^\n]+\.\r?\n\r?\n/, '').trim()) continue;
+    if (inventory.some(skill => skill.name === match[1] && key(skill.filePath) === key(match[2]))) loaded.add(match[1]);
+  }
+  return [...loaded].sort();
+}
+
+export function qualifySkillLoading(messages, inventory) {
+  const loaded = loadedNativeSkills(messages, inventory);
+  if (!loaded.length) return messages;
+  const qualified = `${hint} Complete native skill bodies already in this conversation count as loaded. Already injected native skills: ${loaded.join(', ')}. Follow those bodies; do not reread their SKILL.md merely to activate them. Names, paths, summaries, and catalog entries alone do not count. Supporting files and explicit refreshes still use normal permitted reads.`;
+  return messages.map(message => {
+    if (message.role !== 'system') return message;
+    const replace = value => value.includes(qualified) ? value : value.replace(hint, qualified);
+    return { ...message, content: typeof message.content === 'string' ? replace(message.content)
+      : message.content.map(part => part.type === 'text' ? { ...part, text: replace(part.text) } : part),
+      ...(message.sections ? { sections: Object.fromEntries(Object.entries(message.sections).map(([name, value]) => [name, value === null ? null : replace(value)])) } : {}),
+    };
+  });
+}
+
+export default function workerSkillLoading(pi) {
+  let inventory = [];
+  pi.on('before_agent_start', event => { inventory = event.systemPromptOptions.skills.map(skill => ({ name: skill.name, filePath: skill.filePath })); });
+  pi.on('context_with_system', event => ({ messages: qualifySkillLoading(event.messages, inventory) }));
+}
diff --git a/src/request-shape.mjs b/src/request-shape.mjs
new file mode 100644
index 0000000..ee50931
--- /dev/null
+++ b/src/request-shape.mjs
@@ -0,0 +1,33 @@
+import { createHash } from 'node:crypto';
+import { appendFileSync } from 'node:fs';
+
+const hash = value => createHash('sha256').update(JSON.stringify(value ?? null)).digest('hex');
+
+// No headers, credentials, response bodies, reasoning items, or raw prompts.
+export function requestShape(payload) {
+  if (!payload || typeof payload !== 'object') return { unsupported: true };
+  const input = Array.isArray(payload.input) ? payload.input : [];
+  return {
+    model: payload.model,
+    instructions_hash: hash(payload.instructions),
+    instructions_chars: typeof payload.instructions === 'string' ? payload.instructions.length : 0,
+    native_skill_hint_qualified: typeof payload.instructions === 'string' && payload.instructions.includes('Already injected native skills:'),
+    tools_hash: hash(payload.tools),
+    tool_names: (payload.tools ?? []).map(tool => tool.name ?? tool.type),
+    cache_key_hash: payload.prompt_cache_key ? hash(payload.prompt_cache_key) : null,
+    parallel_tool_calls: payload.parallel_tool_calls,
+    input_shape: input.map(item => ({ type: item.type, role: item.role,
+      // Only user text is compared. Assistant/hidden reasoning is never recorded.
+      ...(item.role === 'user' ? { content_hash: hash(item.content) } : {}),
+    })),
+  };
+}
+
+export default function requestShapeExtension(pi) {
+  let calls = 0;
+  pi.on('before_provider_request', (event, ctx) => {
+    const file = ctx.sessionManager.getSessionFile();
+    if (!file) throw new Error('Request-shape telemetry requires a session file.');
+    appendFileSync(`${file}.request-shape.jsonl`, JSON.stringify({ call: ++calls, ...requestShape(event.payload) }) + '\n');
+  });
+}
